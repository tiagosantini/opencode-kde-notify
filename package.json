{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-kde-notify",
  "version": "0.1.0",
  "description": "Native KDE Plasma / freedesktop notifications for OpenCode on Linux, delivered directly over D-Bus",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Tiago Santini",
    "url": "https://github.com/tiagosantini"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiagosantini/opencode-kde-notify.git"
  },
  "homepage": "https://github.com/tiagosantini/opencode-kde-notify#readme",
  "bugs": {
    "url": "https://github.com/tiagosantini/opencode-kde-notify/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "notifications",
    "notify-send",
    "kde",
    "plasma",
    "linux"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
